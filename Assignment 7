# ============================================================
# ASSIGNMENT 1 - FILE HANDLING
# ============================================================

# Create sample input.txt file
with open("input.txt", "w") as f:
    f.write("Python is powerful.\n")
    f.write("It is widely used in AI.\n")
    f.write("File handling is essential.\n")
    f.write("This is the fourth line.\n")

# Read data from input.txt
with open("input.txt", "r") as f:
    lines = f.readlines()

# Count total number of lines
line_count = len(lines)

# Extract first two lines
first_two = lines[:2]

# Write first two lines into output.txt
with open("output.txt", "w") as f:
    f.writelines(first_two)

print("ASSIGNMENT 1")
print("Total number of lines in input file:", line_count)
print("First two lines have been written to output.txt")

# Output:
# ASSIGNMENT 1
# Total number of lines in input file: 4
# First two lines have been written to output.txt


# ============================================================
# ASSIGNMENT 2 - CSV TO JSON CONVERSION
# ============================================================

import csv
import json

# Create sample input.csv file
with open("input.csv", "w", newline="") as f:
    writer = csv.writer(f)
    writer.writerow(["Name", "Age", "City"])
    writer.writerow(["Rashmi", 30, "Pune"])
    writer.writerow(["Amit", 25, "Mumbai"])
    writer.writerow(["Sneha", 28, "Nashik"])

# Read data from CSV file
csv_data = []

with open("input.csv", "r") as f:
    reader = csv.DictReader(f)
    for row in reader:
        csv_data.append(row)

# Convert CSV data to JSON
json_data = json.dumps(csv_data, indent=4)

# Write JSON data to output.json
with open("output.json", "w") as f:
    f.write(json_data)

print("\nASSIGNMENT 2")
print("CSV data has been converted to JSON and saved as output.json")

# Output:
# ASSIGNMENT 2
# CSV data has been converted to JSON and saved as output.json


