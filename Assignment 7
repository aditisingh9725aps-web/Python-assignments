import re

# Task 1: Count Words Starting with Capital Letters
text = "Python is Great. Regex is Powerful."
result = re.findall(r"\b[A-Z]\w+", text)

print("\nASSIGNMENT 3")
print("Task 1:", result)

# Output:
# Task 1: ['Python', 'Great', 'Regex', 'Powerful']


# Task 2: Extract All Email Addresses
text = "Contact us at support@example.com or admin@test.org"
emails = re.findall(r"[\w\.-]+@[\w\.-]+\.\w+", text)

print("Task 2:", emails)

# Output:
# Task 2: ['support@example.com', 'admin@test.org']


# Task 3: Mask Sensitive Numbers
text = "My card number is 1234-5678-9876-5432"

masked = re.sub(
    r"\d{4}-\d{4}-\d{4}-(\d{4})",
    r"****-****-****-\1",
    text
)

print("Task 3:", masked)

# Output:
# Task 3: My card number is ****-****-****-5432


# Task 4: Extract Hashtags
text = "Learning #Python #Regex #AI is fun!"
hashtags = re.findall(r"#\w+", text)

print("Task 4:", hashtags)

# Output:
# Task 4: ['#Python', '#Regex', '#AI']


# Task 5: Validate Phone Number
phone = "123-456-7890"

if re.match(r"^\d{3}-\d{3}-\d{4}$", phone):
    print("Task 5: Valid phone number")
else:
    print("Task 5: Invalid phone number")

# Output:
# Task 5: Valid phone number


# ============================================================
# ASSIGNMENT 4 - COMMAND-LINE SCRIPT USING ARGPARSE
# ============================================================

import argparse
import sys

# Example command-line arguments for Jupyter/Colab
sys.argv = ["calculator_cli.py", "10", "5", "--operation", "mul"]

# Create parser
parser = argparse.ArgumentParser(
    description="Mini Calculator CLI"
)

# Add positional arguments
parser.add_argument(
    "num1",
    type=float,
    help="First number"
)

parser.add_argument(
    "num2",
    type=float,
    help="Second number"
)

# Add optional operation argument
parser.add_argument(
    "--operation",
    choices=["add", "sub", "mul", "div"],
    default="add",
    help="Operation to perform (default: add)"
)

# Parse arguments
args = parser.parse_args()

# Perform calculation
if args.operation == "add":
    result = args.num1 + args.num2

elif args.operation == "sub":
    result = args.num1 - args.num2

elif args.operation == "mul":
    result = args.num1 * args.num2

elif args.operation == "div":
    if args.num2 != 0:
        result = args.num1 / args.num2
    else:
        result = "Error: Division by zero"

# Display result
print("\nASSIGNMENT 4")
print(f"Result: {result}")

# Output:
# ASSIGNMENT 4
# Result: 50.0
